# PRERAAK People OS — environment template.
# Copy to .env.local for development. Never commit real values.

# --- Database (Neon free tier in production) ---------------------------------
# Neon: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# --- Auth.js -----------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Full origin of the deployment, e.g. https://people.preraak.in
AUTH_URL=

# --- Email (Resend free tier) ------------------------------------------------
# When RESEND_API_KEY is empty, sign-in links are printed to the server console
# instead of being emailed. Development only — never leave empty in production.
RESEND_API_KEY=
EMAIL_FROM=

# --- Development seed guards -------------------------------------------------
# The seed script refuses to run unless SEED_CONFIRM=DEV, and refuses a
# non-local DATABASE_URL unless SEED_ALLOW_REMOTE=true. Never set these in
# a production environment.
SEED_CONFIRM=
SEED_ALLOW_REMOTE=

# --- Stage 3 (documents). Not read by Stage 1 code. --------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
