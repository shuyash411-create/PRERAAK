# PRERAAK People OS — environment template.
# Copy to .env.local for development. Never commit real values.

# --- Database (Neon free tier in production) ---------------------------------
# Neon gives you two connection strings for the same database. DATABASE_URL is
# the pooled one (PgBouncer, add "-pooler" to the hostname) — the app uses it
# at runtime, since a serverless function opens a fresh connection per
# invocation and would exhaust Neon's connection limit without pooling.
# DIRECT_URL is the unpooled one — `prisma migrate deploy` uses it, since DDL
# and migration advisory locks don't work reliably through pooling. Locally
# both are the same local Postgres.
DATABASE_URL=
DIRECT_URL=

# --- Auth.js -----------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Full origin of the deployment, e.g. https://people.preraak.in
AUTH_URL=

# --- Email (Resend free tier) ------------------------------------------------
# When RESEND_API_KEY is empty, sign-in links are printed to the server console
# instead of being emailed. Development only — never leave empty in production.
RESEND_API_KEY=
EMAIL_FROM=

# --- Development seed guards -------------------------------------------------
# The seed script refuses to run unless SEED_CONFIRM=DEV, and refuses a
# non-local DATABASE_URL unless SEED_ALLOW_REMOTE=true. Never set these in
# a production environment.
SEED_CONFIRM=
SEED_ALLOW_REMOTE=

# --- Scheduled jobs (weekly digest, Friday reminder) -------------------------
# Compared against the Authorization: Bearer header Vercel Cron attaches
# automatically once this is set as a project env var. Generate with:
#   openssl rand -hex 32
# Required in production; the cron routes refuse every request without it.
CRON_SECRET=

# --- Stage 3 (documents). Not read by Stage 1 code. --------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
